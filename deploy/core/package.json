{
  "name": "LightTable",
  "description": "LightTable Electron App",
  "version": "0.9.0",
  "main": "main.js",
  "browserWindowOptions": {
    "icon": "img/lticon.png",
    "width": 1024,
    "height": 700,
    "minWidth": 400,
    "minHeight": 400,
    "webPreferences": {
      "nodeIntegration": true,
      "contextIsolation": false,
      "sandbox": false,
      "webviewTag": true,
      "spellcheck": false,
      "backgroundThrottling": false
    }
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "bencode": "^2.0.1",
    "codemirror": "^5.61.0",
    "jsonify": "*",
    "replace": "^1.2.1",
    "request": "^2.88.2",
    "shelljs": "^0.8.4",
    "socket.io": "^4.0.1",
    "tar": "^6.1.0",
    "yargs": "^16.2.0"
  },
  "forkedDependencies": {}
}
